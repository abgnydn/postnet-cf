{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "postnet-cf",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "COORD", "class_name": "Coord" },
      { "name": "TOURNAMENT", "class_name": "Tournament" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Coord"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Tournament"]
    }
  ],
  "r2_buckets": [
    { "binding": "SNAPSHOTS", "bucket_name": "postnet-snapshots", "preview_bucket_name": "postnet-snapshots-preview" }
  ],
  "observability": { "enabled": true }
}
