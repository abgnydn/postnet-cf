{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "postnet-cf",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "COORD", "class_name": "Coord" },
      { "name": "TOURNAMENT", "class_name": "Tournament" },
      { "name": "TERNARY", "class_name": "Ternary" },
      { "name": "TOURNAMENT_LM", "class_name": "TournamentLM" },
      { "name": "TOURNAMENT_SPSA_LM", "class_name": "TournamentSpsaLM" },
      { "name": "TOURNAMENT_LM_BIG", "class_name": "TournamentLMBig" },
      { "name": "TOURNAMENT_SPSA_LM_BIG", "class_name": "TournamentSpsaLMBig" },
      { "name": "TOURNAMENT_HEAD_FLIP", "class_name": "TournamentHeadFlip" },
      { "name": "TOURNAMENT_HEAD_SPSA", "class_name": "TournamentHeadSpsa" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Coord"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Tournament"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["Ternary"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["TournamentLM"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["TournamentSpsaLM"]
    },
    {
      "tag": "v6",
      "new_sqlite_classes": ["TournamentLMBig", "TournamentSpsaLMBig"]
    },
    {
      "tag": "v7",
      "new_sqlite_classes": ["TournamentHeadFlip", "TournamentHeadSpsa"]
    }
  ],
  "r2_buckets": [
    { "binding": "SNAPSHOTS", "bucket_name": "postnet-snapshots", "preview_bucket_name": "postnet-snapshots-preview" }
  ],
  "observability": { "enabled": true }
}
